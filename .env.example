# Backend (Cloudflare Worker) — .dev.vars format
# Copy the values into backend/.dev.vars for local dev.
SESSION_SECRET=change-me-to-a-long-random-string
# Datadog — leave blank until you sign up
DD_API_KEY=
DD_SITE=datadoghq.com
DD_SERVICE=wedding-planner-api
DD_ENV=dev

# Frontend (Vite) — copied into frontend/.env.local
VITE_API_BASE=http://localhost:8787
VITE_DD_RUM_APP_ID=
VITE_DD_RUM_CLIENT_TOKEN=
VITE_DD_ENV=dev

# GitHub Actions secrets (set in repo settings, not here):
#   CF_API_TOKEN     — Cloudflare API token (Workers + Pages + D1 edit)
#   CF_ACCOUNT_ID    — Cloudflare account id
#   SESSION_SECRET   — same as above, production value
#   DD_API_KEY       — production DD api key
